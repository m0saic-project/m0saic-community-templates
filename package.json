{
  "name": "@m0saic/community-templates",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m0saic-project/m0saic-community-templates.git"
  },
  "homepage": "https://github.com/m0saic-project/m0saic-community-templates#readme",
  "bugs": {
    "url": "https://github.com/m0saic-project/m0saic-community-templates/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "template-manifest.json",
    "assets",
    "dep-allowlist.json",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node tools/copy-assets.mjs && node dist/gen-template-manifest.js",
    "serve:dev": "node tools/serve-dev.js",
    "test": "jest"
  },
  "dependencies": {
    "@m0saic/dsl": "^2.0.0",
    "@m0saic/dsl-stdlib": "^3.0.0",
    "@m0saic/platform": "^0.2.0",
    "@m0saic/template-utils": "^0.2.0",
    "@m0saic/types": "^0.2.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5"
  }
}
